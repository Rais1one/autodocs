<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основные поверхности -->

    <SolidColorBrush x:Key="BackgroundBrush"
                     Color="#10151F"/>

    <SolidColorBrush x:Key="SidebarBrush"
                     Color="#151C29"/>

    <SolidColorBrush x:Key="CardBrush"
                     Color="#1B2433"/>

    <SolidColorBrush x:Key="StatBrush"
                     Color="#202C3D"/>

    <SolidColorBrush x:Key="InputBrush"
                     Color="#111B29"/>

    <SolidColorBrush x:Key="DialogBrush"
                     Color="#1C2636"/>

    <!-- Кнопки и навигация -->

    <SolidColorBrush x:Key="AccentBrush"
                     Color="#487DF0"/>

    <SolidColorBrush x:Key="ButtonBrush"
                     Color="#2B394D"/>

    <SolidColorBrush x:Key="NavigationActiveBrush"
                     Color="#283B57"/>

    <SolidColorBrush x:Key="NavigationTextBrush"
                     Color="#B4C0D2"/>

    <!-- Текст -->

    <SolidColorBrush x:Key="TextBrush"
                     Color="#E8EDF7"/>

    <SolidColorBrush x:Key="MutedTextBrush"
                     Color="#94A3B8"/>

    <SolidColorBrush x:Key="DescriptionBrush"
                     Color="#A7B5C9"/>

    <!-- Границы -->

    <SolidColorBrush x:Key="BorderBrush"
                     Color="#303D50"/>

    <SolidColorBrush x:Key="ButtonBorderBrush"
                     Color="#42526B"/>

    <SolidColorBrush x:Key="SidebarBorderBrush"
                     Color="#293244"/>

    <!-- Статусы -->

    <SolidColorBrush x:Key="SuccessBrush"
                     Color="#9CE6C3"/>

    <SolidColorBrush x:Key="SuccessBackgroundBrush"
                     Color="#24463C"/>

    <SolidColorBrush x:Key="WarningBrush"
                     Color="#FFD38A"/>

    <SolidColorBrush x:Key="WarningBackgroundBrush"
                     Color="#55452B"/>

    <SolidColorBrush x:Key="ErrorBrush"
                     Color="#FFB1B6"/>

    <SolidColorBrush x:Key="ErrorBackgroundBrush"
                     Color="#503039"/>
	<Style TargetType="ComboBox">
    <Setter Property="Background"
            Value="{StaticResource InputBrush}"/>
    <Setter Property="Foreground"
            Value="{StaticResource TextBrush}"/>
    <Setter Property="BorderBrush"
            Value="{StaticResource ButtonBorderBrush}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="MinHeight" Value="38"/>

    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="ComboBox">

                <Grid>

                    <ToggleButton
                        Focusable="False"
                        ClickMode="Press"
                        IsChecked="{Binding IsDropDownOpen,
                            RelativeSource={RelativeSource TemplatedParent},
                            Mode=TwoWay}">

                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">

                                <Border
                                    Background="{StaticResource InputBrush}"
                                    BorderBrush="{StaticResource ButtonBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                    <Path Data="M 0 0 L 5 5 L 10 0"
                                          Stroke="{StaticResource MutedTextBrush}"
                                          StrokeThickness="1.5"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>

                                </Border>

                            </ControlTemplate>
                        </ToggleButton.Template>

                    </ToggleButton>

                    <ContentPresenter
                        Content="{TemplateBinding SelectionBoxItem}"
                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                        IsHitTestVisible="False"
                        VerticalAlignment="Center"
                        Margin="12,0,30,0"/>

                    <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           Focusable="False"
                           PopupAnimation="Fade">

                        <Border
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource ButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4"
                            Margin="0,4,0,0"
                            MinWidth="{TemplateBinding ActualWidth}">

                            <ScrollViewer MaxHeight="250">
                                <ItemsPresenter/>
                            </ScrollViewer>

                        </Border>

                    </Popup>

                </Grid>

            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<Style TargetType="ComboBoxItem">

    <Setter Property="Foreground"
            Value="{StaticResource TextBrush}"/>

    <Setter Property="Background"
            Value="Transparent"/>

    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="Cursor" Value="Hand"/>

    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">

                <Border x:Name="ItemBorder"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="6">

                    <ContentPresenter/>

                </Border>

                <ControlTemplate.Triggers>

                    <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="{StaticResource ButtonBrush}"/>
                    </Trigger>

                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="ItemBorder"
                                Property="Background"
                                Value="{StaticResource NavigationActiveBrush}"/>
                    </Trigger>

                </ControlTemplate.Triggers>

            </ControlTemplate>
        </Setter.Value>
    </Setter>

</Style>




</ResourceDictionary>
