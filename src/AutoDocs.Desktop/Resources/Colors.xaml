<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основные поверхности -->

    <SolidColorBrush x:Key="BackgroundBrush"
                     Color="#10151F"/>

    <SolidColorBrush x:Key="SidebarBrush"
                     Color="#151C29"/>

    <SolidColorBrush x:Key="CardBrush"
                     Color="#1B2433"/>

    <SolidColorBrush x:Key="StatBrush"
                     Color="#202C3D"/>

    <SolidColorBrush x:Key="InputBrush"
                     Color="#111B29"/>

    <SolidColorBrush x:Key="DialogBrush"
                     Color="#1C2636"/>

    <!-- Кнопки и навигация -->

    <SolidColorBrush x:Key="AccentBrush"
                     Color="#487DF0"/>

    <SolidColorBrush x:Key="ButtonBrush"
                     Color="#2B394D"/>

    <SolidColorBrush x:Key="NavigationActiveBrush"
                     Color="#283B57"/>

    <SolidColorBrush x:Key="NavigationTextBrush"
                     Color="#B4C0D2"/>

    <!-- Текст -->

    <SolidColorBrush x:Key="TextBrush"
                     Color="#E8EDF7"/>

    <SolidColorBrush x:Key="MutedTextBrush"
                     Color="#94A3B8"/>

    <SolidColorBrush x:Key="DescriptionBrush"
                     Color="#A7B5C9"/>

    <!-- Границы -->

    <SolidColorBrush x:Key="BorderBrush"
                     Color="#303D50"/>

    <SolidColorBrush x:Key="ButtonBorderBrush"
                     Color="#42526B"/>

    <SolidColorBrush x:Key="SidebarBorderBrush"
                     Color="#293244"/>

    <!-- Статусы -->

    <SolidColorBrush x:Key="SuccessBrush"
                     Color="#9CE6C3"/>

    <SolidColorBrush x:Key="SuccessBackgroundBrush"
                     Color="#24463C"/>

    <SolidColorBrush x:Key="WarningBrush"
                     Color="#FFD38A"/>

    <SolidColorBrush x:Key="WarningBackgroundBrush"
                     Color="#55452B"/>

    <SolidColorBrush x:Key="ErrorBrush"
                     Color="#FFB1B6"/>

    <SolidColorBrush x:Key="ErrorBackgroundBrush"
                     Color="#503039"/>

</ResourceDictionary>
