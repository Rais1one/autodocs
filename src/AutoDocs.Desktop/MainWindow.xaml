<Window x:Class="AutoDocs.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AutoDocs.Desktop.Views"
        Title="AutoDocs"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,25">

            <DockPanel LastChildFill="True">

                <TextBlock DockPanel.Dock="Bottom"
                           Text="AutoDocs · WPF"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="12,20"/>

                <StackPanel>

                    <TextBlock Text="◈ AutoDocs"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="10,0,0,7"/>

                    <TextBlock Text="Документация API без рутины"
                               FontSize="12"
                               Foreground="#8D9BB2"
                               TextWrapping="Wrap"
                               Margin="10,0,0,30"/>

                    <!-- Главная -->

                    <Button Content="⌂  Главная"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Home">

                        <Button.Style>

                            <Style TargetType="Button"
                                   BasedOn="{StaticResource NavigationButtonStyle}">

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding CurrentPage}"
                                                 Value="Home">

                                        <Setter Property="Background"
                                                Value="{StaticResource NavigationActiveBrush}"/>

                                        <Setter Property="Foreground"
                                                Value="White"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                    <!-- Результаты -->

                    <Button Content="☷  Результаты проверки"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Results">

                        <Button.Style>

                            <Style TargetType="Button"
                                   BasedOn="{StaticResource NavigationButtonStyle}">

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding CurrentPage}"
                                                 Value="Results">

                                        <Setter Property="Background"
                                                Value="{StaticResource NavigationActiveBrush}"/>

                                        <Setter Property="Foreground"
                                                Value="White"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                    <!-- История -->

                    <Button Content="◷  История"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="History">

                        <Button.Style>

                            <Style TargetType="Button"
                                   BasedOn="{StaticResource NavigationButtonStyle}">

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding CurrentPage}"
                                                 Value="History">

                                        <Setter Property="Background"
                                                Value="{StaticResource NavigationActiveBrush}"/>

                                        <Setter Property="Foreground"
                                                Value="White"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Основная область -->

        <Grid Grid.Column="1"
              Margin="38,38,38,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ContentControl Grid.Row="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">

                <ContentControl.Style>

                    <Style TargetType="ContentControl">

                        <Setter Property="ContentTemplate">

                            <Setter.Value>

                                <DataTemplate>
                                    <views:HomeView/>
                                </DataTemplate>

                            </Setter.Value>

                        </Setter>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding CurrentPage}"
                                         Value="Results">

                                <Setter Property="ContentTemplate">

                                    <Setter.Value>

                                        <DataTemplate>
                                            <views:ResultsView/>
                                        </DataTemplate>

                                    </Setter.Value>

                                </Setter>

                            </DataTrigger>

                            <DataTrigger Binding="{Binding CurrentPage}"
                                         Value="History">

                                <Setter Property="ContentTemplate">

                                    <Setter.Value>

                                        <DataTemplate>
                                            <views:HistoryView/>
                                        </DataTemplate>

                                    </Setter.Value>

                                </Setter>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </ContentControl.Style>

                <ContentControl.Content>
                    <Binding/>
                </ContentControl.Content>

            </ContentControl>

            <!-- Общая строка состояния -->

            <StackPanel Grid.Row="1"
                        Margin="0,16,0,0">

                <ProgressBar Height="5"
                             IsIndeterminate="{Binding IsBusy}"
                             Background="{StaticResource CardBrush}"
                             Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>

                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,10,0,0"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>



