<Window x:Class="AutoDocs.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoDocs"
        Height="720"
        Width="1152"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <TextBlock Text="AutoDocs"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,16"/>

            <TextBlock Text="{Binding ProjectName}"
                       FontSize="20"
                       FontWeight="SemiBold"/>

            <TextBox Text="{Binding ProjectPath, Mode=OneWay}"
                     IsReadOnly="True"
                     Padding="8"
                     Margin="0,8,0,0"/>

            <StackPanel Orientation="Horizontal"
                        Margin="0,16,0,16">

                <Button Content="Выбрать проект"
                        Command="{Binding SelectProjectCommand}"
                        Padding="16,8"
                        Margin="0,0,8,0"/>

                <Button Content="Сформировать документацию"
                        Command="{Binding GenerateCommand}"
                        Padding="16,8"
                        Margin="0,0,8,0"/>

                <Button Content="Проверить актуальность"
                        Command="{Binding CheckCommand}"
                        Padding="16,8"/>

            </StackPanel>

            <ProgressBar Height="6"
                         IsIndeterminate="{Binding IsBusy}"/>

            <TextBlock Text="{Binding CheckStatus}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,16,0,8"/>

            <WrapPanel Margin="0,0,0,16">

                <StackPanel Width="180">
                    <TextBlock Text="Эндпоинтов в коде"/>
                    <TextBlock Text="{Binding EndpointCount}"
                               FontSize="26"/>
                </StackPanel>

                <StackPanel Width="180">
                    <TextBlock Text="В документации"/>
                    <TextBlock Text="{Binding DocumentedEndpointCount}"
                               FontSize="26"/>
                </StackPanel>

                <StackPanel Width="140">
                    <TextBlock Text="Ошибки"/>
                    <TextBlock Text="{Binding ErrorCount}"
                               Foreground="Firebrick"
                               FontSize="26"/>
                </StackPanel>

                <StackPanel Width="160">
                    <TextBlock Text="Предупреждения"/>
                    <TextBlock Text="{Binding WarningCount}"
                               Foreground="DarkOrange"
                               FontSize="26"/>
                </StackPanel>

            </WrapPanel>

        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Discrepancies}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Уровень"
                                    Binding="{Binding Severity}"
                                    Width="100"/>

                <DataGridTextColumn Header="Тип"
                                    Binding="{Binding Kind}"
                                    Width="170"/>

                <DataGridTextColumn Header="Эндпоинт"
                                    Binding="{Binding EndpointKey}"
                                    Width="200"/>

                <DataGridTextColumn Header="Описание"
                                    Binding="{Binding Message}"
                                    Width="*"/>

                <DataGridTextColumn Header="Строка"
                                    Binding="{Binding Line}"
                                    Width="70"/>

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0">

            <TextBlock Text="{Binding OpenApiPath}"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{Binding MarkdownPath}"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

        </StackPanel>

    </Grid>
</Window>
