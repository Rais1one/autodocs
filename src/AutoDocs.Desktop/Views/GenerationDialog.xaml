<Window x:Class="AutoDocs.Desktop.Views.GenerationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сформировать документацию" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource DialogBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="26">
        <TextBlock Text="Сформировать документацию" Style="{StaticResource CardTitleStyle}"/>
        <TextBlock Text="Настройки генерации для выбранного проекта." Style="{StaticResource MutedTextStyle}"/>
        <TextBlock Text="Формат документации" FontWeight="SemiBold" Margin="0,24,0,12"/>
        <CheckBox x:Name="OpenApiBox" Content="OpenAPI (JSON)" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
        <CheckBox x:Name="MarkdownBox" Content="Markdown" IsChecked="True" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="Папка сохранения" FontWeight="SemiBold" Margin="0,24,0,8"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Обзор" Click="Browse_Click" Margin="8,0,0,0"/>
            <TextBox x:Name="OutputBox" VerticalContentAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="По умолчанию — папка docs внутри проекта." Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" IsCancel="True" Margin="0,0,10,0"/>
            <Button Content="Сформировать" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>



